# Site configuration — contains BLN names, node names, panel IPs.
# Never commit a real one.
site.json
*.site.json

# Local point catalog override
tecpoints.json

# Bridge runtime files. `manifest.json` is generated against a live site and
# carries real node names, device names and point names -- the same reason
# site.json is ignored above. The `.example` files beside them are the
# templates and ARE tracked.
bridge/manifest.json
bridge/bridge_config.json
bridge/site.json
*.log

# Captures — may contain live site traffic
*.pcap
*.pcapng
*.cap

# Scanner output
*.csv
*.json.out
scan_*.json
p2_scan_*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
